# ─────────────────────────────────────────────────────────────────────────────
# Quality Experts — website & CMS environment
# Copy to `.env` and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (PostgreSQL 15+). Example:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quality_experts?schema=public"
# Hosted PostgreSQL that requires SSL: append  ?sslmode=require&uselibpqcompat=true
# Optional: connection pool size per server instance (default 10; use 1–3 on serverless hosts)
# DATABASE_POOL_SIZE=10
# Optional: direct (non-pooled) connection used ONLY for migrations, if DATABASE_URL goes through a pooler
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/quality_experts"

# Long random secret (≥ 32 chars). Used for OTP hashing, form tokens and deriving the
# encryption key for SMTP/IMAP passwords stored in the database.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Optional dedicated key for encrypting stored secrets (defaults to AUTH_SECRET).
# If you rotate it, re-enter the SMTP/IMAP passwords in the CMS.
# ENCRYPTION_KEY=""

# Public URL of the site, no trailing slash (used for canonical URLs, sitemap, e-mails)
NEXT_PUBLIC_SITE_URL="https://qualityconsultants-jo.com"

# Media storage: "db" (default) keeps uploaded images and videos inside PostgreSQL, so moving the
# site to another server only needs a database backup/restore. "local" stores files in UPLOAD_DIR.
STORAGE_DRIVER="db"
# Only used when STORAGE_DRIVER="local" (and by `npm run media:to-db` to import old files)
UPLOAD_DIR="./storage/uploads"

# Set to "true" when running behind a reverse proxy/load balancer so the client IP is taken
# from X-Forwarded-For (rate limiting & audit log).
TRUST_PROXY="false"

# Only for local http testing of a production build: allow non-Secure cookies.
# INSECURE_COOKIES="true"

# ── Outgoing e-mail (fallback) ───────────────────────────────────────────────
# SMTP is normally configured in the CMS (Admin → Email). These variables are used only when
# no SMTP host is saved there. Production REQUIRES working SMTP: admin sign-in codes are e-mailed.
# In development without SMTP, e-mails are written to storage/mail-outbox instead.
SMTP_HOST=""
SMTP_PORT="587"
# starttls | ssl | none
SMTP_SECURITY="starttls"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="info@qc-jo.com"
SMTP_FROM_NAME="Quality Experts"

# ── Initial Super Admin (used by `npm run db:seed` only if the user does not exist) ──
# If SEED_ADMIN_PASSWORD is empty, a strong temporary password is generated and printed once.
SEED_ADMIN_EMAIL="admin@qc-jo.com"
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_PASSWORD=""

# ── Tests ───────────────────────────────────────────────────────────────────
# Integration tests use a separate database (default: <DATABASE_URL database>_test)
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quality_experts_test?schema=public"
# E2E_BASE_URL="http://localhost:3010"

# Emergency switch: set to true to disable e-mailed sign-in codes (password only). Remove afterwards.
# AUTH_DISABLE_OTP=true
